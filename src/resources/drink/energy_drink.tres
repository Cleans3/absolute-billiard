[gd_resource type="Resource" script_class="Drink" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/resources/effect/effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://src/resources/effect/stat_mod.gd" id="2_mod"]
[ext_resource type="Script" path="res://src/resources/effect/drink.gd" id="3_drink"]

[sub_resource type="Resource" id="Mod_0_0"]
script = ExtResource("2_mod")
