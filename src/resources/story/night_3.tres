[gd_resource type="Resource" script_class="StoryNight" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/story/story_night.gd" id="1"]

[resource]
script = ExtResource("1")
night = 3
intro_cards = Array[String](["The Rope is in the room tonight. They don't play. They 'help'. The table leans and the lights flicker.", "Tonight is the big one. Moe swears that if you pay on camera, the door opens. Gus says Moe has never opened a door.", "Gus isn't joking tonight. That's how you know it's real."])
call = Array[String](["My associates will be in the room tonight. Don't thank them.", "Pay it all, on camera, and you walk. My word is on the record.", "Gus. You know what tonight means for you, too."])
gus_lines = Array[String](["Forty years of crews in this room. You're the first I'd bet on.", "If this goes wrong, keep off the floor by the table. Please.", "The pour's on the house tonight. Don't tell Moe. Actually, tell him.", "Whatever he says on that phone, you don't owe him your nerve."])
paid_line = "Good. The city saw that. The city is learning."
short_line = "So close. Gus, open the floor."
chat_line = "last call"
ending_cards = Array[String](["The Buyout clears live, in front of more viewers than this room has ever had. Gus raises a glass. Then the vent opens.", "You wake on a flatbed, at sunrise. The radio: 'Paid in full. The city saw. You're free.' A pause. 'Gus stays.'", "One last line in the chat. velvet: 'good show. same table next week?' You never saw the name until now. He never missed a shot."])
