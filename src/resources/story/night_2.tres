[gd_resource type="Resource" script_class="StoryNight" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/story/story_night.gd" id="1"]

[resource]
script = ExtResource("1")
night = 2
intro_cards = Array[String](["Night two. The door is still bolted. The stream is up, and the chat already knows your names.", "Moe raised the number. 'Interest', he calls it. Gus calls it Tuesday. Gus no longer knows what day it is."])
call = Array[String](["People are watching. Good. Watching is the whole point.", "The number went up. Interest. And tell Gus I noticed the new cushions."])
gus_lines = Array[String](["New cushions? I didn't buy new cushions.", "The Rope came by this afternoon. Ordered water. Tipped in threats.", "That floor by the table? Don't stand on it. It's fine. Just don't stand on it.", "That wanted poster? I didn't scratch the face out. I found it like that."])
paid_line = "You paid again. You're starting to look like an investment."
short_line = "Interest keeps going after you stop. So does the floor."
chat_line = "nice cushions"
ending_cards = Array[String]([])
