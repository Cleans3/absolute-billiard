[gd_resource type="Resource" script_class="StoryNight" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/story/story_night.gd" id="1"]

[resource]
script = ExtResource("1")
night = 1
intro_cards = Array[String](["The Rope took you. A van, a hood, a long road. Then a cabin in the woods, a pool bar inside, and a door that locks from outside.", "Gus's Corner Pocket. One table, one camera, no windows. Gus says the front door hasn't opened since 1979.", "Velvet Moe runs a stream from this room. You are tonight's show. Make the house's quota on camera, or the house keeps you.", "Tonight's number is on the blackboard. Gus says it's a warm-up. Gus is lying."])
call = Array[String](["You're awake. Good. You don't know my voice yet, so let me be clear.", "The number's on the blackboard. Tonight. On stream. The house keeps the ones who miss.", "Gus? Pour them something cheap. They're not leaving yet."])
gus_lines = Array[String](["First Night! I love a first Night. Everybody's so loud.", "Moe's a reasonable man. He reasons with a crowbar, but he reasons.", "Don't look at the phone. It can tell.", "The bar is older than the cabin. Don't ask me how that works."])
paid_line = "Huh. You paid. That's the most interesting thing that's happened in this room in years."
short_line = "You missed by a little. The floor doesn't care how little."
chat_line = "first rack's always the loudest. enjoy it"
ending_cards = Array[String]([])
