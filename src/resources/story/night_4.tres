[gd_resource type="Resource" script_class="StoryNight" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/story/story_night.gd" id="1"]

[resource]
script = ExtResource("1")
night = 4
intro_cards = Array[String](["Gus finally showed you his ledger. Your debt is on page one. His goes on for forty pages.", "'If you pay him off,' Gus says, 'maybe he forgets about me.' He doesn't sound like he believes it."])
call = Array[String](["Gus has been talking. Gus always talks on the fourth Night.", "Two thousand. And then we discuss a final number."])
gus_lines = Array[String](["You saw the ledger. Don't look at me like that. I'm a businessman.", "Forty pages. Some of them are just drawings of a crowbar.", "If you win this, I'm putting your photo above the bar. Next to the wanted poster. For balance.", "He calls on the fourth Night. He always calls on the fourth Night."])
paid_line = "Then it's settled. Tomorrow, the Buyout. Everything. Bring a crowd."
short_line = "So close. People always are, on the fourth Night."
chat_line = "page one. then forty more"
ending_cards = Array[String]([])
