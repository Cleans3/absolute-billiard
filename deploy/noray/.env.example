# Noray relay config (copy to .env, never commit .env). Full key list: github.com/foxssake/noray/.env.example
# The lobby code IS the host's OID, so the relay hands out 6-char Crockford base32 ids (docs/plan/04 §2.3).
NORAY_OID_LENGTH=6
NORAY_OID_CHARSET=0123456789ABCDEFGHJKMNPQRSTVWXYZ

NORAY_SOCKET_HOST=0.0.0.0
NORAY_SOCKET_PORT=8890            # TCP control
NORAY_UDP_REGISTRAR_PORT=8809     # UDP remote registrar
NORAY_UDP_RELAY_PORTS=49152-49251 # UDP relay pool, 2 slots per relayed player
# Metrics stay off the public interface.
NORAY_HTTP_HOST=127.0.0.1
NORAY_HTTP_PORT=8891

NORAY_UDP_RELAY_MAX_INDIVIDUAL_TRAFFIC=128kb
NORAY_LOGLEVEL=info
