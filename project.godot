; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Absolute Billiard"
run/main_scene="res://src/levels/Lobby.tscn"
run/main_scene.m0="res://src/debug/perf_sequence.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/max_fps=60

[autoload]

NetManager="*res://src/core/net_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/deeplink/plugin.cfg")

[gui]

theme/custom="res://src/ui/theme/game_theme.tres"

[file_customization]

folder_colors={
"res://src/core/": "gray",
"res://src/debug/": "red",
"res://src/gameplay/": "blue",
"res://src/levels/": "teal",
"res://src/resources/": "green",
"res://src/shaders/": "orange",
"res://src/ui/": "purple"
}

