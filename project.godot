[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/bounce_velocity_threshold=0.2
jolt_physics_3d/simulation/sleep_velocity_threshold=0.05
jolt_physics_3d/simulation/sleep_time_threshold=0.3
jolt_physics_3d/limits/max_angular_velocity=600.0
common/physics_interpolation=true
common/max_physics_steps_per_frame=8
jolt_physics_3d/limits/max_bodies=512
jolt_physics_3d/limits/max_body_pairs=4096
jolt_physics_3d/limits/max_contact_constraints=2048
jolt_physics_3d/limits/temporary_memory_buffer_size=8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.emu="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=0
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=0
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=0
occlusion_culling/use_occlusion_culling=false
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=4
